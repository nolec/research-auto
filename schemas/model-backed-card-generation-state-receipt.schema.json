{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "preflight_receipt_sha256",
    "owner_token", "owner_host", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "model-backed-card-generation-state-receipt/v1"},
    "status": {"const": "IN_PROGRESS"},
    "preflight_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "owner_host": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
