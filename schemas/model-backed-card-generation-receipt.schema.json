{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "policy_version", "preflight_receipt_sha256",
    "model_run_receipt_sha256", "model_output_sha256", "cards_sha256",
    "markdown_sha256", "card_count", "artifacts", "model_outputs_persisted",
    "raw_responses_persisted", "promotion_allowed", "source_eligibility_required"
  ],
  "properties": {
    "schema_version": {"const": "model-backed-card-generation-receipt/v1"},
    "status": {"const": "CANDIDATE_ONLY"},
    "policy_version": {"const": "model-backed-card-generation-v1"},
    "preflight_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_run_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cards_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "card_count": {"type": "integer", "minimum": 3},
    "artifacts": {"const": ["cards.json", "cards.md"]},
    "model_outputs_persisted": {"const": false},
    "raw_responses_persisted": {"const": false},
    "promotion_allowed": {"const": false},
    "source_eligibility_required": {"const": true}
  }
}
