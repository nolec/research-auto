{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "operational_next_action", "smoke_run_id", "smoke_receipt_sha256", "smoke_manifest_hash", "capacity_manifest_hash", "smoke_authorization_hash", "authorized_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "status": {"const": "AUTHORIZED"},
    "operational_next_action": {"const": "run_analysis"}, "smoke_run_id": {"type": "string", "minLength": 1},
    "smoke_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "smoke_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capacity_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "smoke_authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorized_at": {"type": "string", "format": "date-time"}
  }
}
