{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-auto.local/schemas/source-feasibility-decision.schema.json",
  "title": "Source Feasibility Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_version",
    "source",
    "status",
    "evaluated_at",
    "policy_evidence",
    "policy_evidence_sha256",
    "product_requirements",
    "decision_basis_sha256",
    "data_classes",
    "required_gates",
    "blockers",
    "next_action"
  ],
  "properties": {
    "decision_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "NOT_ELIGIBLE"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "policy_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "checked_at", "claim"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "checked_at": {"type": "string", "format": "date-time"},
          "claim": {"type": "string", "minLength": 20}
        }
      }
    },
    "policy_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_basis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_window_days", "stable_author_identity_required", "immutable_evidence_required"],
      "properties": {
        "evidence_window_days": {"type": "integer", "minimum": 1},
        "stable_author_identity_required": {"type": "boolean"},
        "immutable_evidence_required": {"type": "boolean"}
      }
    },
    "data_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "policy_class", "persisted", "max_retention_days", "refresh_method", "deletion_method", "stable_across_runs", "evidence_ids"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "policy_class": {"type": "string", "minLength": 1},
          "persisted": {"type": "boolean"},
          "max_retention_days": {"type": ["integer", "null"], "minimum": 1},
          "refresh_method": {"type": ["string", "null"], "minLength": 1},
          "deletion_method": {"type": ["string", "null"], "minLength": 1},
          "stable_across_runs": {"type": "boolean"},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_ids", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unresolved"]},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 20}
        }
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_action": {"enum": ["implement_adapter", "replace_source", "seek_compliance_clearance"]}
  }
}
