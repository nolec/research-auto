{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "source", "feasibility_hash", "api", "allocation", "allocation_hash", "window", "window_hash", "selection", "notice_scope", "fields", "forbidden_contact_fields", "sort", "strata", "thresholds", "pagination", "retry", "privacy", "query_contract_hash"],
  "properties": {
    "manifest_version": {"const": "1.1.0"},
    "source": {"const": "ted"},
    "feasibility_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "api": {"type": "object", "additionalProperties": false, "required": ["version", "base_url", "endpoint", "method", "authentication", "scope", "pagination_mode", "check_query_syntax"], "properties": {"version": {"const": "3.0"}, "base_url": {"const": "https://api.ted.europa.eu"}, "endpoint": {"const": "/v3/notices/search"}, "method": {"const": "POST"}, "authentication": {"const": "none"}, "scope": {"const": "ALL"}, "pagination_mode": {"const": "PAGE_NUMBER"}, "check_query_syntax": {"const": false}}},
    "allocation": {"type": "object", "additionalProperties": false, "required": ["provisional_quota_per_stratum", "oversampling_factor", "required_unique_per_stratum", "target_unique_total"], "properties": {"provisional_quota_per_stratum": {"const": 25}, "oversampling_factor": {"const": 1.5}, "required_unique_per_stratum": {"type": "integer", "minimum": 1}, "target_unique_total": {"type": "integer", "minimum": 1}}},
    "allocation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "window": {"type": "object", "additionalProperties": false, "required": ["published_from", "published_before", "query_from_date", "query_to_date", "from_inclusive", "before_exclusive"], "properties": {"published_from": {"type": "string", "format": "date-time"}, "published_before": {"type": "string", "format": "date-time"}, "query_from_date": {"pattern": "^[0-9]{8}$"}, "query_to_date": {"pattern": "^[0-9]{8}$"}, "from_inclusive": {"const": true}, "before_exclusive": {"const": true}}},
    "window_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selection": {"type": "object", "additionalProperties": false, "required": ["max_items_per_buyer"], "properties": {"max_items_per_buyer": {"type": "integer", "minimum": 1}}},
    "notice_scope": {"type": "object", "additionalProperties": false, "required": ["form_type", "allowed_notice_types", "change_indicator_field", "exclude_change_notices"], "properties": {"form_type": {"const": "competition"}, "allowed_notice_types": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["pin-cfc-standard", "pin-cfc-social", "qu-sy", "cn-standard", "cn-social", "subco", "cn-desg"]}}, "change_indicator_field": {"const": "change-notice-version-identifier"}, "exclude_change_notices": {"const": true}}},
    "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_contact_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sort": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["field", "direction"], "properties": {"field": {"type": "string"}, "direction": {"enum": ["ASC", "DESC"]}}}},
    "strata": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["name", "priority", "cpv_prefix", "quota", "query"], "properties": {"name": {"type": "string"}, "priority": {"type": "integer", "minimum": 1}, "cpv_prefix": {"pattern": "^[0-9]{2}$"}, "quota": {"const": 38}, "query": {"type": "string", "minLength": 1}}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["procedure_completeness_min", "buyer_completeness_min", "text_completeness_min", "acceptance_yield_min", "processed_max_per_stratum"], "properties": {"procedure_completeness_min": {"type": "number", "minimum": 0, "maximum": 1}, "buyer_completeness_min": {"type": "number", "minimum": 0, "maximum": 1}, "text_completeness_min": {"type": "number", "minimum": 0, "maximum": 1}, "acceptance_yield_min": {"type": "number", "minimum": 0, "maximum": 1}, "processed_max_per_stratum": {"type": "integer", "minimum": 1}}},
    "pagination": {"type": "object", "additionalProperties": false, "required": ["page_size", "max_logical_requests_per_stratum", "max_logical_requests_total", "max_attempts_per_logical_request", "max_http_attempts_total", "request_timeout_seconds", "deadline_seconds", "max_response_bytes_total"], "properties": {"page_size": {"type": "integer", "minimum": 1, "maximum": 100}, "max_logical_requests_per_stratum": {"type": "integer", "minimum": 1}, "max_logical_requests_total": {"type": "integer", "minimum": 1}, "max_attempts_per_logical_request": {"type": "integer", "minimum": 1}, "max_http_attempts_total": {"type": "integer", "minimum": 1}, "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}, "deadline_seconds": {"type": "number", "exclusiveMinimum": 0}, "max_response_bytes_total": {"type": "integer", "minimum": 1}}},
    "retry": {"type": "object", "additionalProperties": false, "required": ["retryable_statuses", "max_retries_per_logical_request", "base_backoff_seconds", "max_backoff_seconds"], "properties": {"retryable_statuses": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}}, "max_retries_per_logical_request": {"type": "integer", "minimum": 0}, "base_backoff_seconds": {"type": "number", "minimum": 0}, "max_backoff_seconds": {"type": "number", "minimum": 0}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["free_text_email_action", "free_text_phone_action", "redaction_placeholder", "persist_raw_payloads", "persist_candidate_items"], "properties": {"free_text_email_action": {"const": "redact"}, "free_text_phone_action": {"const": "redact"}, "redaction_placeholder": {"const": "[REDACTED_CONTACT]"}, "persist_raw_payloads": {"const": false}, "persist_candidate_items": {"const": false}}},
    "query_contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
